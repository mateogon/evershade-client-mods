!/build/network-probe/probe.xml
/drops/*
!/drops/app.js
!/drops/index.html
/profiles/*
!/profiles/LeaderPlayer.xml
!/profiles/FollowerOne.xml
!/profiles/FollowerTwo.xml
*.log
*.jsonl
*.sol
*.swf
*.dll
*.exe
*.zip
*.air
*.bin
*.p12
*.pfx
*.pem
.env*
*credentials*
*session*
local.*
