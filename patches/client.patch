+      private function labClearShot(player:Player, target:GameObject, projectile:XML) : Boolean
+      {
+         // Straight-line tile traversal; curved/boomerang trajectories are not predicted.
+         var x:int = Math.floor(player.x_);
+         var y:int = Math.floor(player.y_);
+         var endX:int = Math.floor(target.x_);
+         var endY:int = Math.floor(target.y_);
+         var dx:Number = target.x_ - player.x_;
+         var dy:Number = target.y_ - player.y_;
+         var stepX:int = dx >= 0 ? 1 : -1;
+         var stepY:int = dy >= 0 ? 1 : -1;
+         var deltaX:Number = dx == 0 ? Number.POSITIVE_INFINITY : 1 / Math.abs(dx);
+         var deltaY:Number = dy == 0 ? Number.POSITIVE_INFINITY : 1 / Math.abs(dy);
+         var sideX:Number = dx == 0 ? Number.POSITIVE_INFINITY : (dx > 0 ? x + 1 - player.x_ : player.x_ - x) * deltaX;
+         var sideY:Number = dy == 0 ? Number.POSITIVE_INFINITY : (dy > 0 ? y + 1 - player.y_ : player.y_ - y) * deltaY;
+         var steps:int = Math.abs(endX - x) + Math.abs(endY - y) + 1;
+         for(var i:int = 0; i < steps; i++)
+         {
+            var square:Square = this.gs_.map.getSquare(x + 0.5,y + 0.5);
+            if(square == null || square.tileType_ == 255) return false;
+            var obstacle:GameObject = square.obj_;
+            if(!projectile.hasOwnProperty("PassesEverything") && obstacle != null && obstacle.props_ != null && !obstacle.props_.isEnemy_ && (obstacle.props_.enemyOccupySquare_ || (!projectile.hasOwnProperty("PassesCover") && obstacle.props_.occupySquare_))) return false;
+            if(x == endX && y == endY) return true;
+            if(sideX < sideY) { x += stepX; sideX += deltaX; }
+            else if(sideY < sideX) { y += stepY; sideY += deltaY; }
+            else { x += stepX; y += stepY; sideX += deltaX; sideY += deltaY; }
+         }
+         return false;
+      }
