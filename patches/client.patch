+      private function labTarget(player:Player, ability:Boolean = false) : GameObject
+      {
+         if((!ability && !Parameters.data_.labAutoAim) || !this.labCombatMap()) return null;
+         var weapon:XML = ObjectLibrary.xmlLibrary_[player.equipment_[0]];
+         if(!ability && (weapon == null || !weapon.hasOwnProperty("Projectile"))) return null;
+         var range:Number = ability ? 12 : Number(weapon.Projectile[0].Speed) * Number(weapon.Projectile[0].LifetimeMS) / 10000;
+         if(!isFinite(range) || range <= 0) return null;
+         var weaponRange:Number = range;
+         if(!ability) range *= 1.2;
+         var best:GameObject = null;
+         var bestQuest:Boolean = false;
+         var bestInRange:Boolean = false;
+         var bestDistance:Number = Number.MAX_VALUE;
+         for each(var target:GameObject in this.gs_.map.goDict_)
+         {
+            if(target == null || target == player || target.hp_ <= 0) continue;
+            var xml:XML = ObjectLibrary.xmlLibrary_[target.objectType_];
+            if(xml == null || !xml.hasOwnProperty("Enemy")) continue;
+            if((ability || !Parameters.data_.labPreShoot) && (target.isInvulnerable() || target.isInvincible())) continue;
+            var dx:Number = target.x_ - player.x_;
+            var dy:Number = target.y_ - player.y_;
+            var distance:Number = dx * dx + dy * dy;
+            if(distance > range * range) continue;
+            var inRange:Boolean = distance <= weaponRange * weaponRange;
+            if(!ability && int(Parameters.data_.labAimMode) == 1)
+            {
+               var difference:Number = Math.atan2(dy,dx) - Parameters.data_.cameraAngle - Math.atan2(this.gs_.map.cursorY_,this.gs_.map.cursorX_);
+               if(Math.abs(Math.atan2(Math.sin(difference),Math.cos(difference))) > Math.PI / 12) continue;
+            }
+            var quest:Boolean = this.gs_.map.quest_ != null && this.gs_.map.quest_.objectIds_.indexOf(target.objectId_) >= 0;
+            if(best == null || (inRange && !bestInRange) || (inRange == bestInRange && ((quest && !bestQuest) || (quest == bestQuest && (target.maxHP_ > best.maxHP_ || (target.maxHP_ == best.maxHP_ && distance < bestDistance))))))
+            {
+               if(!ability && !this.labClearShot(player,target,weapon.Projectile[0])) continue;
+               best = target;
+               bestInRange = inRange;
+               bestQuest = quest;
+               bestDistance = distance;
+            }
+         }
+         return best;
+      }
