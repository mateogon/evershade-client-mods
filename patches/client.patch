+      private function labCanUseStatPotion(player:Player, potion:Object) : Boolean
+      {
+         var fields:Array = potion.fields;
+         var maximum:Number = Number(player[fields[2]]);
+         if(!isFinite(maximum) || maximum <= 0) return false;
+         if(Number(player[fields[0]]) - Number(player[fields[1]]) < maximum) return true;
+         var stored:Number = Number(player[fields[3]]);
+         var capacity:Number = Number(player[fields[3] + "_Max"]);
+         if(this.labPotionStatus_[fields[3]] != stored + "/" + capacity)
+         {
+            this.labPotionStatus_[fields[3]] = stored + "/" + capacity;
+            trace("[Lab potion] " + fields[3] + " maxed; storage=" + stored + "/" + capacity);
+         }
+         // Storage units need not equal XML stat points. Let the server accept/reject
+         // one use when space is reported; the pending-use backoff prevents spam.
+         return isFinite(stored) && stored >= 0 && isFinite(capacity) && capacity > 0 && stored < capacity;
+      }
