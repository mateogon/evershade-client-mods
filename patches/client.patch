+         var xml:XML = ObjectLibrary.xmlLibrary_[type];
+         if(xml == null || !xml.hasOwnProperty("Tier") || !xml.hasOwnProperty("SlotType") || xml.hasOwnProperty("Consumable")) return true;
+         for each(var tag:String in ["Rare","SetTier","SNormal","SPlus","Origin","Mortal","Divine","Legendary","Godly","Mythical","Olympian","Celestial","GlitchedTier","ReskinTier","Shiny","MountTier","LootBox","@setType"])
+         {
+            if(xml.hasOwnProperty(tag)) return true;
+         }
+         if(ObjectLibrary.propsLibrary_[type] != null && ObjectLibrary.propsLibrary_[type].isShiny_) return true;
+         var tier:Number = Number(xml.Tier);
+         if(!isFinite(tier) || tier < 0) return true;
+         var slotType:int = int(xml.SlotType);
+         if(slotType == 9) return tier >= int(Parameters.data_.labLootRingTier);
+         for each(var character:XML in ObjectLibrary.playerChars_)
