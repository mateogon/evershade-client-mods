+      private function labLootBag(player:Player) : Container
+      {
+         var best:Container = null;
+         var bestDistance:Number = 1;
+         for each(var object:GameObject in this.gs_.map.goDict_)
+         {
+            var bag:Container = object as Container;
+            if(bag == null || !bag.isLoot_ || bag.equipment_ == null || (bag.ownerId_ >= 0 && !bag.isBoundToCurrentAccount())) continue;
+            var dx:Number = bag.x_ - player.x_;
+            var dy:Number = bag.y_ - player.y_;
+            var distance:Number = dx * dx + dy * dy;
+            if(distance > bestDistance) continue;
+            for(var slot:int = 0; slot < Math.min(8,bag.equipment_.length); slot++)
+            {
+               if(this.labLootDestination(player,bag.equipment_[slot]) >= 0)
+               {
+                  best = bag;
+                  bestDistance = distance;
+                  break;
+               }
+            }
+         }
+         return best;
+      }
