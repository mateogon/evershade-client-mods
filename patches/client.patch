+               {
+                  this.labLootPending_ = false;
+                  this.labPotionPendingBag_ = null;
+                  this.labLootAt_ = now;
+                  return;
+               }
+               if(now - this.labLootAt_ < 3000) return;
+               trace("[Lab potion] No bag-slot confirmation for type=" + this.labPotionPendingType_ + "; retry paused 30s");
+               this.labPotionBlockedUntil_[this.labPotionPendingType_] = now + 30000;
+               this.labPotionPendingBag_ = null;
+               this.labLootPending_ = false;
+               this.labLootAt_ = now;
+               return;
+            }
+            if(this.gs_.gsc_.labInvResultSequence == this.labLootSequence_ && now - this.labLootAt_ < 3000) return;
+            this.labLootPending_ = false;
+            if(this.gs_.gsc_.labInvResultSequence == this.labLootSequence_ || this.gs_.gsc_.labInvResultCode != 0)
+            {
+               this.labLootAt_ = now + 2500;
+               return;
+            }
+            this.labLootAt_ = now;
+         }
+         if(player == null || player.dead_ || player.isPaused() || !this.enablePlayerInput_ || this.gs_.isGroupStunActive() || !this.labCombatMap() || now - this.labLootAt_ < 500) return;
+         var bag:Container = this.labLootBag(player);
+         if(bag == null) return;
+         for(var slot:int = 0; slot < Math.min(8,bag.equipment_.length); slot++)
+         {
+            var destination:int = this.labLootDestination(player,bag.equipment_[slot]);
+            if(destination < 0) continue;
+            this.labLootSequence_ = this.gs_.gsc_.labInvResultSequence;
+            this.labLootAt_ = now;
+            if(destination == 256)
+            {
+               this.labPotionPendingBag_ = bag;
+               this.labPotionPendingSlot_ = slot;
+               this.labPotionPendingType_ = bag.equipment_[slot];
+               this.labLootPending_ = this.gs_.gsc_.useItem_new(bag,slot,2);
+               if(!this.labLootPending_)
+               {
+                  this.labPotionBlockedUntil_[this.labPotionPendingType_] = now + 30000;
+                  this.labPotionPendingBag_ = null;
+               }
+            }
+            else if(destination == 254 || destination == 255)
+            {
+               this.labLootPending_ = this.gs_.gsc_.invSwapPotion(player,bag,slot,bag.equipment_[slot],player,destination,-1);
+            }
+            else
+            {
+               this.labLootPending_ = this.gs_.gsc_.invSwap(player,bag,slot,bag.equipment_[slot],player,destination,-1);
+            }
+            return;
+         }
+      }
