+         var statPotion:Object = this.labStatPotion(type);
+         if(statPotion != null)
+         {
+            if(Number(this.labPotionBlockedUntil_[type]) > getTimer()) return -1;
+            return this.labCanUseStatPotion(player,statPotion) ? 256 : -1;
+         }
+         if(type == 2594 || type == 2595)
+         {
+            var potion:Object = this.potionInventoryModel.getPotionModel(type);
+            if(potion != null && player.getPotionCount(type) < potion.maxPotionCount) return PotionInventoryModel.getPotionSlot(type);
+            return -1;
+         }
+         var slot:int = player.nextAvailableInventorySlot();
+         return slot >= 4 && slot < Math.min(player.equipment_.length,player.hasBackpack_ ? 20 : 12) && player.equipment_[slot] == -1 ? slot : -1;
+      }
