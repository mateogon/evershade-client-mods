+      private function labStatPotion(type:int) : Object
+      {
+         var xml:XML = ObjectLibrary.xmlLibrary_[type];
+         if(xml == null || !xml.hasOwnProperty("Consumable") || !xml.hasOwnProperty("Potion") || xml.Activate.length() != 1 || String(xml.@id).toLowerCase().indexOf("potion of ") < 0) return null;
+         var effect:XML = xml.Activate[0];
+         if(String(effect) != "IncrementStat" || String(effect.@percentage).toLowerCase() == "true") return null;
+         var fields:Array = null;
+         switch(int(effect.@stat))
+         {
+            case 0: fields = ["maxHP_","maxHPBoost_","maxHPMax_","SPS_Life"]; break;
+            case 3: fields = ["maxMP_","maxMPBoost_","maxMPMax_","SPS_Mana"]; break;
+            case 20: fields = ["attack_","attackBoost_","attackMax_","SPS_Attack"]; break;
+            case 21: fields = ["defense_","defenseBoost_","defenseMax_","SPS_Defense"]; break;
+            case 22: fields = ["speed_","speedBoost_","speedMax_","SPS_Speed"]; break;
+            case 26: fields = ["vitality_","vitalityBoost_","vitalityMax_","SPS_Vitality"]; break;
+            case 27: fields = ["wisdom_","wisdomBoost_","wisdomMax_","SPS_Wisdom"]; break;
+            case 28: fields = ["dexterity_","dexterityBoost_","dexterityMax_","SPS_Dexterity"]; break;
+         }
+         var amount:Number = Number(effect.@amount);
+         return fields != null && isFinite(amount) && amount > 0 ? {fields:fields,amount:amount} : null;
+      }
