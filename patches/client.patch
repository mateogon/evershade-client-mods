+      public static function labPortalUsed(gs:GameSprite, id:int) : void
+      {
+         labPortalOffer_ = null;
+         var player:Player = gs.map.player_;
+         var portal:Portal = gs.map.goDict_[id] as Portal;
+         if(player == null || player.name_ != "LeaderPlayer" || portal == null || !portal.active_ || portal.lockedPortal_) return;
+         if(Math.abs(player.x_ - portal.x_) > 1.5 || Math.abs(player.y_ - portal.y_) > 1.5) return;
+         labPortalOffer_ = {stamp:new Date().time,leader:player.objectId_,id:id,type:portal.objectType_,x:portal.x_,y:portal.y_,name:portal.getName(),map:gs.map.name_,game:gs.gsc_.gameId_,host:gs.gsc_.server_.address,port:gs.gsc_.server_.port};
+      }
+
+      public static function labPortalConfirmed(game:int, host:String, port:int) : void
+      {
+         var offer:Object = labPortalOffer_;
+         labPortalOffer_ = null;
+         if(offer == null || new Date().time - offer.stamp > 4000) return;
+         offer.destinationGame = game;
+         offer.destinationHost = host;
+         offer.destinationPort = port;
+         try
+         {
+            if(labPortalSender_ == null)
+            {
+               labPortalSender_ = new LocalConnection();
+               labPortalSender_.addEventListener(StatusEvent.STATUS,labPortalSendStatus);
+               labPortalSender_.addEventListener(AsyncErrorEvent.ASYNC_ERROR,labPortalAsyncError);
+            }
+            labPortalSender_.send("app#Evershade.Lab.FollowerOne:labPortals","labReceivePortal",offer);
+            labPortalSender_.send("app#Evershade.Lab.FollowerTwo:labPortals","labReceivePortal",offer);
+         }
+         catch(error:Error) { trace("[Lab portals] Local delivery failed."); }
+      }
