+      private function labUseAbility(player:Player, x:Number, y:Number, phase:int) : Boolean
+      {
+         if(Parameters.data_.labAimAbility && !(player.isUnstable() && !player.isUnstableImmune()))
+         {
+            var target:GameObject = this.labTarget(player,true);
+            if(target != null && target.posS_ != null && target.posS_.length >= 5)
+            {
+               var world:Point = this.gs_.map.pSTopW(target.posS_[3],target.posS_[4]);
+               if(world != null && Math.abs(world.x - target.x_) < 0.75 && Math.abs(world.y - target.y_) < 0.75)
+               {
+                  x = target.posS_[3];
+                  y = target.posS_[4];
+               }
+            }
+         }
+         return player.useAltWeapon(x,y,phase);
+      }
       
